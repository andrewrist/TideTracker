# Copy to /etc/pi-sensor-server/env and replace placeholder values.
# This file is read by app.wsgi on every Apache (re)start.

# ----- MySQL ----------------------------------------------------------------
# The app connects over a local Unix socket. Adjust the path if your distro
# uses a different one:
#   Debian/Ubuntu (MariaDB / MySQL 8) : /var/run/mysqld/mysqld.sock
#   RHEL / Rocky / Alma              : /var/lib/mysql/mysql.sock
MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
MYSQL_DB=pi_sensors
MYSQL_USER=sensor_writer
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD

# ----- API -------------------------------------------------------------------
# Comma-separated list of tokens that Pi clients may use in their
# Authorization: Bearer <token> header. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=REPLACE_WITH_LONG_RANDOM_TOKEN

# Optional HTTP-basic password for the dashboard (username: admin).
# Leave empty to make the dashboard publicly readable.
DASHBOARD_PASSWORD=

LOG_LEVEL=INFO

# ----- Display ---------------------------------------------------------------
# Tide height threshold line shown on the dashboard and tides charts (feet).
TIDE_THRESHOLD_FT=0.9
